# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class

# raw 3D generator exports in root (optimized assets reside in public/models/)
/*.glb
Meshy_AI*.glb
*_original.glb
*_backup.glb

# personal documentation, reports and jira task imports
/docs/
/import_safe.csv
*.csv

# agent scaffolding, internal specifications & constitution
/.agents/
/.specify/
/specs/
constitution.md

# local ide configuration & personal tool settings
/.cursor/
/.antigravity/

# one-off migration & verification scripts
scripts/make_import_safe.py
scripts/verify-db.ts
scripts/generate-real-rooms.ts

# uncompressed heavy raw models (>50MB, web uses optimized assets)
public/models/cs1/T*.glb
!public/models/cs1/toa_*.glb
public/models/cs1/*.zip
*.skp
tools/analyze_*.js
