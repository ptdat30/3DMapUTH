{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoutePathApiContract",
  "description": "Giao ước Hợp đồng API tính toán tuyến đường dẫn đường UTH 3DMap",
  "endpoint": "/api/route-path",
  "method": "POST",
  "request": {
    "type": "object",
    "required": ["originBuildingCode", "targetBuildingCode"],
    "properties": {
      "originBuildingCode": {
        "type": "string",
        "description": "Mã định danh tòa nhà xuất phát (ví dụ: toa_h)",
        "example": "toa_h"
      },
      "targetBuildingCode": {
        "type": "string",
        "description": "Mã định danh tòa nhà đích đến (ví dụ: toa_j)",
        "example": "toa_j"
      },
      "originQrCode": {
        "type": "string",
        "description": "Mã QR tại vị trí xuất phát nếu có quét thực tế",
        "example": "cs3_qr_toa_h_sanh"
      },
      "targetRoomCode": {
        "type": "string",
        "description": "Mã phòng học đích đến nếu có nhu cầu dẫn tận phòng",
        "example": "J102"
      }
    }
  },
  "response": {
    "type": "object",
    "required": ["success"],
    "properties": {
      "success": {
        "type": "boolean",
        "description": "Trạng thái thành công của yêu cầu",
        "example": true
      },
      "source": {
        "type": "string",
        "enum": ["DATABASE", "OFFLINE_FALLBACK"],
        "description": "Nguồn dữ liệu trả về (Từ DB PostgreSQL hay Cache ngoại tuyến)",
        "example": "DATABASE"
      },
      "route": {
        "type": "object",
        "properties": {
          "totalDistance": {
            "type": "number",
            "description": "Tổng chiều dài cung đường (mét)",
            "example": 75.5
          },
          "estimatedMinutes": {
            "type": "number",
            "description": "Thời gian đi bộ ước tính (phút)",
            "example": 1.2
          },
          "fullPathPoints": {
            "type": "array",
            "description": "Mảng các tọa độ [x, y, z] dựng đường cong 3D",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "example": [
              [0, 0.2, 0],
              [-15, 0.2, -2],
              [-35, 0.2, -6],
              [-50, 0.2, -8],
              [-65, 0.2, -10]
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stepOrder", "instruction", "directionType", "cameraPos", "cameraTarget"],
              "properties": {
                "id": { "type": "string" },
                "stepOrder": { "type": "integer" },
                "stage": { "type": "string", "enum": ["OUTDOOR", "INDOOR"] },
                "instruction": { "type": "string" },
                "directionType": { "type": "string", "enum": ["STRAIGHT", "LEFT", "RIGHT", "ARRIVED"] },
                "cameraPos": {
                  "type": "array",
                  "items": { "type": "number" }
                },
                "cameraTarget": {
                  "type": "array",
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      },
      "error": {
        "type": "string",
        "description": "Thông báo lỗi nếu success = false"
      }
    }
  }
}

